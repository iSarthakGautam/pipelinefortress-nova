{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iSarthakGautam/pipelinefortress-nova/scanners/schema/finding.schema.json",
  "title": "PipelineFortress unified finding",
  "description": "v1.0.0. Owner: R2. Everything except `triage` is deterministic (normalizer/enricher/baseline). `triage` is the only model-produced block and is optional until the AI stage runs. Breaking changes after week 1 need an ADR + channel heads-up.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "finding_id", "tool", "rule_id", "severity_raw", "severity_norm", "cwe", "cve", "location", "package", "evidence", "baseline"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "finding_id": {
      "description": "sha256(tool|rule_id|file|line|pkg)[:16], lowercase hex. When one file has the same finding for two versions of a package, every version after the lowest uses sha256(tool|rule_id|file|line|pkg|version)[:16].",
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "tool": {
      "type": "string",
      "enum": ["semgrep", "bandit", "gosec", "trivy", "osv", "grype", "gitleaks", "checkov", "hadolint", "conftest", "zap", "falco"]
    },
    "rule_id": { "description": "Scanner's own rule/check/advisory ID (R4 cluster.py keys on this).", "type": "string", "minLength": 1 },
    "message": { "description": "Scanner message, UNTRUSTED text (injection surface). Redact before any LLM use.", "type": "string" },
    "severity_raw": { "description": "Verbatim scanner severity (ERROR, HIGH, 7.5 ...).", "type": "string" },
    "severity_norm": { "description": "Mapped via scanners/normalize/severity_map.yaml.", "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"] },
    "cwe": { "type": "array", "items": { "type": "string", "pattern": "^CWE-[0-9]+$" }, "uniqueItems": true },
    "cve": {
      "description": "Only IDs the SCANNER reported. The model may never add to this list.",
      "type": "array",
      "items": { "type": "string", "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$" },
      "uniqueItems": true
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line"],
      "properties": {
        "file": { "description": "Repo-relative, forward slashes.", "type": "string" },
        "line": { "type": "integer", "minimum": 0 }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "fixed_version"],
      "properties": {
        "name": { "type": ["string", "null"] },
        "version": { "type": ["string", "null"] },
        "fixed_version": { "type": ["string", "null"] }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_ref"],
      "properties": {
        "snippet": { "description": "Raw code snippet. Runner-local only; input to R4's redactor. Never published.", "type": "string" },
        "snippet_redacted": { "description": "Written by the redaction stage (R4), not the normalizer.", "type": "string" },
        "raw_ref": { "description": "Pointer into the raw scanner output, e.g. artifacts/scans/semgrep.sarif#/runs/0/results/17", "type": "string" }
      }
    },
    "enrichment": {
      "description": "Written by enrich.py (R4).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "epss": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "kev": { "type": "boolean" },
        "reachable": { "type": ["boolean", "null"] }
      }
    },
    "baseline": {
      "description": "Written by baseline diff (R2). Gate fails only when is_new is true and not excepted.",
      "type": "object",
      "additionalProperties": false,
      "required": ["is_new", "first_seen_commit"],
      "properties": {
        "is_new": { "type": "boolean" },
        "first_seen_commit": { "type": ["string", "null"] },
        "exception": {
          "description": "From '# security-exception: <id> expires:<date> owner:<name>'.",
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["id", "expires", "owner"],
          "properties": {
            "id": { "type": "string" },
            "expires": { "type": "string", "format": "date" },
            "owner": { "type": "string" }
          }
        }
      }
    },
    "dedupe": {
      "description": "Written by cluster.py (R4).",
      "type": "object",
      "additionalProperties": false,
      "required": ["cluster_id", "cluster_size"],
      "properties": {
        "cluster_id": { "type": "string" },
        "cluster_size": { "type": "integer", "minimum": 1 }
      }
    },
    "triage": {
      "description": "MODEL OUTPUT. Everything else in this object is deterministic.",
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "priority", "confidence", "fix_summary", "model", "prompt_version", "grounding"],
      "properties": {
        "verdict": { "type": "string", "enum": ["TRUE_POSITIVE", "FALSE_POSITIVE", "NEEDS_HUMAN_REVIEW"] },
        "priority": { "type": "string", "enum": ["P1", "P2", "P3", "UNASSIGNED"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "fix_summary": { "type": "string" },
        "model": { "type": "string" },
        "prompt_version": { "type": "string" },
        "grounding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["validated", "rejected_claims"],
          "properties": {
            "validated": { "type": "boolean" },
            "rejected_claims": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
